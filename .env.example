# Public, embedded in browser builds. Required in development and production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Supabase secret API key (sb_secret_...), required for internal
# action/audit repositories and PostgreSQL rate-limit RPC. Never NEXT_PUBLIC.
# Supabase's legacy service_role key is compatible, but prefer a new secret key.
SUPABASE_SECRET_KEY=

# Server-only canonical origin. Local: http://localhost:5000
# Production: exact HTTPS origin; used for Origin checks and auth email redirects.
APP_BASE_URL=

# Shopify: server-only. Real authorization needs an HTTPS app/tunnel origin.
# APP_BASE_URL and this redirect must use the SAME public HTTPS origin.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_inventory
SHOPIFY_REDIRECT_URI=
# Optional, during Shopify client-secret rotation only.
SHOPIFY_PREVIOUS_CLIENT_SECRET=

# AES-256-GCM keyring: JSON object of version -> base64 32-byte random key.
# Development example SHAPE ONLY: {"v1":"<base64-32-byte-key>"}
# Production: inject from a managed secret store, never a committed file/image.
SHOPIFY_VAULT_KEYS=
SHOPIFY_VAULT_ACTIVE_KEY=
# Production refuses vault use unless this is managed-secret-store.
# This declares the deployment's key delivery, it does not provision a secret manager.
SHOPIFY_VAULT_KEY_SOURCE=

# Reserved for future AI-provider vault support. Does not enable BYOK.
CREDENTIAL_KMS_KEY_ID=
